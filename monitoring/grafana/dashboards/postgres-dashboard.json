      "title": "Cache Hit Ratio",
      "type": "stat",
      "targets": [{ "expr": "pg_stat_database_blks_hit{datname=\"myapp\"} / (pg_stat_database_blks_hit{datname=\"myapp\"} + pg_stat_database_blks_read{datname=\"myapp\"})", "refId": "A" }]
