        { "expr": "rate(pg_stat_database_xact_rollback{datname=\"myapp\"}[1m])", "legendFormat": "Rollbacks", "refId": "B" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
